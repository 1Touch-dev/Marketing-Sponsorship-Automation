# ==========================================
# CORE APPLICATION
# ==========================================
NODE_ENV=development
APP_NAME=market-sponsorship-automation
APP_ENV=development
APP_URL=http://localhost:3000

# ==========================================
# AWS / BEDROCK
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Bedrock inference profile / model id (Claude Sonnet)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Direct Anthropic API — optional fallback used automatically by
# frontend/lib/bedrock/client.ts when a Bedrock call itself fails (invalid/
# rotated AWS credentials, region outage). Same model, same pricing. Get one
# at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ==========================================
# SUPABASE
# ==========================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# ==========================================
# GOOGLE / GMAIL OAUTH
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback
GMAIL_TEST_ACCOUNT=

# ==========================================
# N8N → Next.js (orchestration)
# ==========================================
# Base URL of this app as seen by n8n (no trailing slash). Set same in n8n as MSA_APP_URL.
MSA_APP_URL=http://localhost:3000

# ==========================================
# OPTIONAL: harden /api/workflows/audit
# ==========================================
# If set, callers must send header: x-msa-webhook-secret: <same value>
MSA_INTERNAL_WEBHOOK_SECRET=

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=
N8N_EDITOR_BASE_URL=
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# ==========================================
# FRONTEND (exposed to browser)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# STORAGE
# ==========================================
SUPABASE_STORAGE_BUCKET_PROPOSALS=proposals
SUPABASE_STORAGE_BUCKET_ASSETS=campaign-assets
SUPABASE_STORAGE_BUCKET_AUDIT=audit-files

# ==========================================
# EMAIL / WORKFLOW DEFAULTS
# ==========================================
DEFAULT_FROM_EMAIL=
DEFAULT_REPLY_TO=
FOLLOWUP_DELAY_DAYS=3
MAX_CAMPAIGN_IDEAS=5

# ==========================================
# COST CONTROLS
# ==========================================
# Hard daily ceiling (USD, UTC calendar day) on paid AI calls (Bedrock text +
# OpenAI image generation) — see frontend/lib/monitoring/spend-guard.ts.
# Once today's recorded spend meets/exceeds this, new calls are refused until
# the next UTC day. Defaults to $25/day if unset (~$750/mo) — well above
# normal observed usage (~$271/mo total per the Aug 2026 cost audit) but a
# real, finite circuit breaker rather than no limit at all. Tune to taste.
DAILY_SPEND_CAP_USD=25

# ==========================================
# SECURITY
# ==========================================
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_SECRET=

# ==========================================
# BACKUPS (Pattern 7 hardening — see frontend/scripts/run-backup.ts)
# ==========================================
# MUST be a DIFFERENT AWS identity from AWS_ACCESS_KEY_ID above — a
# dedicated IAM user with put-only access to one Object-Locked S3 bucket,
# no delete permission on anything. If unset, run-backup.ts falls back to
# writing locally (NOT an isolated/offsite backup — see script warning).
# Setup steps: docs/DEPLOYMENT_AND_RUNTIME.md, "Backups" section.
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=us-east-1
BACKUP_S3_BUCKET=
# Optional: enables S3 Object Lock (WORM) on each upload for this many days.
# Bucket must have Object Lock enabled at creation time for this to work.
BACKUP_S3_OBJECT_LOCK_DAYS=

# ==========================================
# OPTIONAL
# ==========================================
CANVA_TEAM_ID=
AMPLIFY_APP_ID=
GITHUB_REPO_URL=
GITHUB_TOKEN=

# ==========================================
# REPLICATE — AI image generation for jersey/stadium mockups
# ==========================================
REPLICATE_API_TOKEN=
# Trained Coritiba 2026 Away Jersey LoRA model (trigger: coritiba_jersey)
REPLICATE_MODEL_VERSION=abhishek9302/coritiba-jersey-lora:76169e0ab5d4effa7c6eb4ce9bfc2e7ac739e4e38a855a26943b67800d2eaf9e

# ==========================================
# HUNTER.IO — Contact/email enrichment (decision makers)
# Get from: https://hunter.io/api-keys
# ==========================================
HUNTER_API_KEY=

# ==========================================
# APOLLO.IO — Company intelligence (org enrich, dept headcount, funding)
# People search / email reveal need Basic+ plan. Get key: Settings → Integrations → Apollo API
# https://docs.apollo.io/docs/create-api-key
# ==========================================
APOLLO_API_KEY=

# ==========================================
# LOGO.DEV — Company logo scraping (frontend/lib/companies/logo-enrichment.ts)
# Free publishable key ("pk_..."), get one at https://logo.dev/signup
# If unset/expired, the resolver falls back to Apollo org enrichment, then
# a Google favicon (always resolves, lowest quality).
# ==========================================
LOGO_DEV_TOKEN=
